[Unit]
Description=Nova Boutique - release expired stock reservations
After=network.target mariadb.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/nova.hacheinteractive.com/app
ExecStart=/usr/bin/php /var/www/nova.hacheinteractive.com/app/bin/release-expired-reservations.php
NoNewPrivileges=true
PrivateTmp=true
